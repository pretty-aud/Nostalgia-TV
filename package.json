{
  "name": "nostalgia-tv",
  "version": "0.1.0",
  "description": "A personal TV channel: shuffles shows, keeps every show's episodes in order.",
  "main": "electron/main.js",
  "author": "Petal Studios",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild src/renderer/index.js --bundle --outfile=src/renderer/bundle.js --format=iife --sourcemap",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/vendor-ffmpeg.mjs --ensure && npm run build && electron-builder",
    "deploy": "npm run dist && node scripts/install-local.mjs",
    "vendor:ffmpeg": "node scripts/vendor-ffmpeg.mjs"
  },
  "build": {
    "appId": "co.petalstudios.shuffletv",
    "productName": "Nostalgia TV",
    "files": [
      "electron/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/fonts/**/*",
      "src/renderer/bundle.js",
      "src/shared/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nostalgia TV",
      "artifactName": "Nostalgia TV Setup.exe"
    },
    "portable": {
      "artifactName": "Nostalgia TV (portable).exe"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.10"
  }
}
